ENVIRONMENT=local
# Frontend origins allowed to call the API (comma-separated or JSON list)
BACKEND_CORS_ORIGINS=http://localhost:3000,http://localhost:3001


# OTD Delhi GTFS-RT private key (https://otd.delhi.gov.in)
OTD_DELHI_API=

# --- Free geodata (no key needed; these are the defaults) ---
# Overpass powers real attractions/restaurants/hotels from OpenStreetMap.
# The main instance is busy, so a comma-separated mirror list is tried in order.
# OVERPASS_URL=https://overpass-api.de/api/interpreter
# OVERPASS_MIRRORS=https://overpass-api.de/api/interpreter,https://overpass.kumi.systems/api/interpreter
# NOMINATIM_URL=https://nominatim.openstreetmap.org/search
# Polite User-Agent — Wikimedia 403s anything without a contact URL + email.
# GEO_USER_AGENT=DestinifyTripAgent/1.0 (https://github.com/destinify/destinify; you@example.com)
# OPENVERSE_IMAGES_URL=https://api.openverse.org/v1/images/
# WIKIPEDIA_SUMMARY_URL=https://en.wikipedia.org/api/rest_v1/page/summary/{title}

# --- Optional paid providers (auto-upgrade: used only when a key is set) ---
# Restaurant photos + ratings (Yelp Fusion v3)
YELP_API_KEY=
# Live flight offers (Amadeus self-service free test environment)
AMADEUS_KEY=
AMADEUS_SECRET=
# AMADEUS_HOST=https://test.api.amadeus.com

# Memory + geodata caching
# SHORT_MEMORY_TURNS=12
# GEO_CACHE_TTL_SECONDS=21600
