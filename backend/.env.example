ENVIRONMENT=local
# Frontend origins allowed to call the API (comma-separated or JSON list)
BACKEND_CORS_ORIGINS=http://localhost:3000,http://localhost:3001
# Groq LLM for the classifier agent (get one at https://console.groq.com)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# Optional overrides: LLM_MODEL selects the Groq model (takes precedence over
# GROQ_MODEL). LLM_BASE_URL + LLM_MODEL + LLM_API_KEY switch to any
# OpenAI-compatible endpoint when langchain-openai is installed.
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_MODEL=openai/gpt-oss-120b
# LLM_API_KEY=
# RapidAPI: one key, hosts depend on your subscribed plans
RAPID_API_KEY=
RAPID_FLIGHT_HOST=sky-scrapper.p.rapidapi.com
RAPID_TRAIN_HOST=irctc1.p.rapidapi.com
RAPID_BUS_HOST=bus-booking.p.rapidapi.com
# OTD Delhi GTFS-RT private key (https://otd.delhi.gov.in)
OTD_DELHI_API=
